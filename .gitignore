# ─── Python Virtual Environments ───────────────────────────────────────────────
# Virtuele omgevingen, voorkomen dat ‘venv/’ of ‘.env/’ in repo komen
.venv/
venv/
env/

# ─── Python Bytecode & Build Artifacts ────────────────────────────────────────
# .pyc, .pyo, egg-info en __pycache__-mappen
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.egg-info/

# ─── Configuration & Secrets ───────────────────────────────────────────────────
# Omgevings- en streamlit-secrets
.env
.env.*
secrets.toml
.streamlit/secrets.toml

# ─── IDE / Editor ─────────────────────────────────────────────────────────────
# VSCode, JetBrains, etc.
.vscode/
.idea/

# ─── Test-output & Caches ─────────────────────────────────────────────────────
# Pytest cache, smoke tests, logs
.pytest_cache/
smoke_output.txt
*.log
streamlit.log

# ─── Temporary & Backup Files ─────────────────────────────────────────────────
# Oudere back-ups en tijdelijke bestandsformaten
*.bak
*.baktmp*
*~
*.swp

# ─── Test Data (optioneel) ─────────────────────────────────────────────────────
# Houd enkel .gitkeep over in tests/data, zodat map wordt meegenomen
tests/data/*
!tests/data/.gitkeep
